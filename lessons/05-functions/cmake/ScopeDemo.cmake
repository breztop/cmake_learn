set(scope_value outer)
function(show_function_scope)
  set(scope_value function-local)
  message(STATUS "Inside function: ${scope_value}")
endfunction()
show_function_scope()
message(STATUS "After function: ${scope_value}")
macro(show_macro_scope)
  set(scope_value changed-by-macro)
endmacro()
show_macro_scope()
message(STATUS "After macro: ${scope_value}")
